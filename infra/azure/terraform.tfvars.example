resource_group_name      = "rg-kite-observability"
location                 = "uksouth"
workspace_name           = "kite-logs"
secondary_workspace_name = "kite-logs-secondary"

# Register every exact origin where Kite is served. Do not add paths.
spa_redirect_uris = [
	"https://kite.humblehamster.com",
	"http://localhost:5173"
]

# Grant the signed-in users (or preferably an Entra security group) query access.
# Leave empty to manage workspace RBAC separately.
workspace_log_reader_principal_ids = [
	"00000000-0000-0000-0000-000000000000"
]

# Grant a service principal or managed identity permission to send records to
# KiteTest_CL through the Logs Ingestion API DCR.
# test_log_ingestor_principal_ids = ["00000000-0000-0000-0000-000000000000"]

# Optional additional app-registration owners.
# application_owner_object_ids = ["00000000-0000-0000-0000-000000000000"]

# Optional cost guardrail.
# daily_quota_gb = 1
