{
	"name": "kite",
	"private": true,
	"version": "0.0.9",
	"type": "module",
	"packageManager": "npm@11.14.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"generate:avro-table-template-types": "node scripts/generate-avro-table-template-types.mjs",
		"generate:kusto-documentation-index": "node scripts/generate-kusto-documentation-index.mjs",
		"generate": "npm run generate:avro-table-template-types && npm run generate:kusto-documentation-index",
		"check:generated": "npm run generate && git diff --exit-code -- src/lib/generated",
		"update:kusto-docs-index": "node scripts/update-kusto-documentation-index.mjs && npm run generate:kusto-documentation-index",
		"download:kusto-docs": "node scripts/download-kusto-documentation.mjs",
		"build:kql-wasm": "node scripts/build-kql-wasm.mjs",
		"verify:kql-wasm": "node scripts/verify-kql-wasm.mjs",
		"profile:kusto-memory": "npm run build && node scripts/profile-kusto-memory.mjs",
		"dev": "vite dev",
		"prebuild": "npm run generate && npm run download:kusto-docs && npm run verify:kql-wasm",
		"build": "vite build",
		"build:container": "node scripts/build-container.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"lint:ci": "prettier --check package.json playwright.config.ts README.md docs/*.md infra/README.md infra/*/README.md scripts .github tests",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:unit:run": "vitest --run",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "npm run build && npm run test:e2e:run",
		"test:e2e:run": "playwright test",
		"test:e2e:install": "playwright install --with-deps chromium",
		"test:smoke": "node scripts/smoke-test.mjs",
		"test:ci": "npm run check:generated && npm run lint:ci && npm run check && npm run test:unit:run && npm run build && npm run test:e2e:run",
		"security:audit": "npm audit --omit=dev --audit-level=high",
		"release:validate-tag": "node scripts/validate-release-tag.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.26.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"json-schema-to-typescript": "^15.0.4",
		"paneforge": "^1.0.2",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-node-polyfills": "^0.28.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.113.0"
	},
	"dependencies": {
		"@azure/msal-browser": "^5.17.0",
		"@duckdb/duckdb-wasm": "1.32.0",
		"@kusto/language-service-next": "^12.4.0",
		"@kusto/monaco-kusto": "^15.0.0",
		"@tanstack/svelte-table": "^9.0.0-beta.65",
		"@tanstack/svelte-virtual": "^3.13.35",
		"avsc": "^5.7.9",
		"azure-kusto-data": "^7.2.0",
		"mode-watcher": "^1.1.0",
		"monaco-editor": "^0.55.1"
	},
	"overrides": {
		"@kusto/monaco-kusto": {
			"@kusto/language-service-next": "^12.4.0"
		}
	}
}
